POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=bugbounty_integration_test
POSTGRES_USER=bugbounty_integration_test
POSTGRES_PASSWORD=bugbounty_integration_test

RABBITMQ_HOST=localhost
RABBITMQ_PORT=55672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:57687
NEO4J_USER=neo4j
NEO4J_PASSWORD=bugbounty-integration-test
NEO4J_DATABASE=neo4j

OPENSEARCH_URL=http://localhost:59200
ENVIRONMENT=integration-test

# Credential secret storage. Encrypted Postgres is the default; generate a local
# key with LocalEncryptedSecretCodec.generate_master_key_b64() and keep it out
# of committed files. Use dev_plaintext only in explicit tests.
CREDENTIAL_SECRET_BACKEND=postgres_encrypted
CREDENTIAL_KEY_ID=integration-local-key
# CREDENTIAL_MASTER_KEY=base64:<32-byte-url-safe-base64>
CREDENTIAL_ALLOW_DEV_PLAINTEXT=false
