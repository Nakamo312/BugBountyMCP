    {
      "id": 500,
      "type": "row",
      "title": "Scheduled State / Pipeline Debt",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "panels": [
        {
          "id": 501,
          "type": "bargauge",
          "title": "Scheduled State Runs",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "decimals": 0
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (node_id, status) (pipeline_scheduled_state_runs{node_id=~\"$node_id\", status=~\"$scheduled_status\"})",
              "legendFormat": "{{node_id}} {{status}}"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 9
          },
          "description": "Active scheduled runs by node and state: queued, leased, running, flushing."
        },
        {
          "id": 502,
          "type": "bargauge",
          "title": "Scheduled State Oldest Age",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "decimals": 0
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "max by (node_id, status) (pipeline_scheduled_state_oldest_age_seconds{node_id=~\"$node_id\", status=~\"$scheduled_status\"})",
              "legendFormat": "{{node_id}} {{status}}"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 9
          },
          "description": "Oldest active scheduled run age by node and state. Leased/running/flushing age reveals stuck state-machine transitions."
        },
        {
          "id": 503,
          "type": "stat",
          "title": "Retry Oldest Age",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "decimals": 0
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "max by (node_id, retry_reason) (pipeline_retry_due_oldest_age_seconds)"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 16,
            "y": 9
          }
        },
        {
          "id": 504,
          "type": "stat",
          "title": "Reconcile Oldest Age",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "decimals": 0
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "max by (node_id, reconcile_reason) (pipeline_reconcile_oldest_age_seconds)"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 0,
            "y": 17
          }
        },
        {
          "id": 505,
          "type": "table",
          "title": "Scheduled Active Runs",
          "datasource": {
            "type": "postgres",
            "uid": "bugbounty-postgres"
          },
          "targets": [
            {
              "refId": "A",
              "format": "table",
              "rawSql": "SELECT node_id, status, count(*)::bigint AS run_count, max(extract(epoch from now() - coalesce(leased_at, started_at, flushing_at, created_at))) AS oldest_state_age_seconds, min(created_at) AS oldest_created_at, min(leased_at) AS oldest_leased_at, min(started_at) AS oldest_started_at, min(flushing_at) AS oldest_flushing_at, max(updated_at) AS last_updated_at FROM runs WHERE execution_mode = 'scheduled' AND status IN ('queued', 'leased', 'running', 'flushing') AND terminal_outcome IS NULL AND needs_reconcile = false GROUP BY node_id, status ORDER BY run_count DESC, oldest_state_age_seconds DESC;"
