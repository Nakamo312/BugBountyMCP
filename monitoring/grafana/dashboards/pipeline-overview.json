          "targets": [
            {
              "refId": "A",
              "expr": "sum by (node_id) (pipeline_worker_capacity{node_id=~\"$node_id\"}) and on() (max(pipeline_worker_registry_available) == 1)",
              "legendFormat": "{{node_id}}"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 8,
            "y": 8
          }
