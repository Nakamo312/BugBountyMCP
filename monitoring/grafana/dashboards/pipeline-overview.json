{
  "uid": "bugbounty-pipeline-overview",
  "title": "BugBounty Pipeline Overview",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "15s",
  "tags": ["bugbounty", "pipeline"],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Running Runs",
      "datasource": {"type": "postgres", "uid": "bugbounty-postgres"},
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS running_runs FROM pipeline_run_overview WHERE run_status = 'running';"
        }
      ],
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Failed Runs",
      "datasource": {"type": "postgres", "uid": "bugbounty-postgres"},
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS failed_runs FROM pipeline_run_overview WHERE run_status = 'failed';"
        }
      ],
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "RabbitMQ Messages Ready",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rabbitmq_queue_messages_ready)"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}
    },
    {
      "id": 4,
      "type": "table",
      "title": "Recent Events",
      "datasource": {"type": "postgres", "uid": "bugbounty-postgres"},
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT created_at, event_type, source, run_status, correlation_id FROM pipeline_event_timeline ORDER BY created_at DESC LIMIT 50;"
        }
      ],
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 12}
    },
    {
      "id": 5,
      "type": "nodeGraph",
      "title": "Pipeline Flow Graph",
      "datasource": {"type": "postgres", "uid": "bugbounty-postgres"},
      "options": {
        "nodes": {},
        "edges": {}
      },
      "targets": [
        {
          "refId": "nodes",
          "format": "table",
          "rawSql": "SELECT id::text AS id, title::text AS title, subtitle::text AS subtitle, mainstat::text AS mainstat, secondarystat::text AS secondarystat, node_type::text AS node_type, status::text AS status, \"nodeRadius\", color::text AS color FROM pipeline_graph_nodes WHERE created_at >= now() - interval '24 hours' UNION ALL SELECT 'placeholder:no-recent-flow' AS id, 'No recent pipeline flow' AS title, 'last 24 hours' AS subtitle, 'idle' AS mainstat, '' AS secondarystat, 'placeholder' AS node_type, NULL::text AS status, 42::numeric AS \"nodeRadius\", 'gray' AS color WHERE NOT EXISTS (SELECT 1 FROM pipeline_graph_nodes WHERE created_at >= now() - interval '24 hours') ORDER BY id;"
        },
        {
          "refId": "edges",
          "format": "table",
          "rawSql": "SELECT id::text AS id, source::text AS source, target::text AS target, mainstat::text AS mainstat, secondarystat::text AS secondarystat, edge_type::text AS edge_type FROM pipeline_graph_edges WHERE created_at >= now() - interval '24 hours' ORDER BY id;"
        }
      ],
      "gridPos": {"h": 14, "w": 24, "x": 0, "y": 22}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Scheduled Queue Depth",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node_id) (pipeline_scheduled_queue_depth)"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 36}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Running Node Runs",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node_id) (pipeline_runs{status=\"running\"})"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 36}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Retry Due Runs",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node_id, retry_reason) (pipeline_retry_due_runs)"
        }
      ],
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 44}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Reconcile Required",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node_id, reconcile_reason) (pipeline_reconcile_runs)"
        }
      ],
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 44}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Run Duration Seconds",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node_id, terminal_outcome) (pipeline_run_duration_seconds_sum) / clamp_min(sum by (node_id, terminal_outcome) (pipeline_run_duration_seconds_count), 1)"
        }
      ],
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 44}
    }
  ]
}
