          },
          "fieldConfig": {
            "defaults": {
              "decimals": 0
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (node_id) (pipeline_worker_busy{node_id=~\"$node_id\"}) and on() (max(pipeline_worker_registry_available) == 1)",
              "legendFormat": "{{node_id}}"
            }
          ],
          "gridPos": {
            "h": 8,
