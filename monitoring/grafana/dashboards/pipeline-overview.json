              "refId": "nodes",
              "format": "table",
              "rawSql": "WITH run_stats AS (SELECT r.node_id, count(*) AS runs_total, count(*) FILTER (WHERE r.execution_mode = 'scheduled' AND r.status = 'queued' AND r.needs_reconcile = false) AS queue_depth, count(*) FILTER (WHERE r.execution_mode = 'scheduled' AND r.status = 'leased' AND r.needs_reconcile = false) AS leased_count, count(*) FILTER (WHERE r.status = 'running') AS running_count, count(*) FILTER (WHERE r.execution_mode = 'scheduled' AND r.status = 'flushing' AND r.needs_reconcile = false) AS flushing_count, count(*) FILTER (WHERE r.status = 'failed') AS failed_count, max(extract(epoch from now() - r.created_at)) FILTER (WHERE r.execution_mode = 'scheduled' AND r.status = 'queued' AND r.needs_reconcile = false) AS oldest_scheduled_age_seconds FROM runs r WHERE r.node_id IS NOT NULL AND $__timeFilter(r.created_at) GROUP BY r.node_id), source_stats AS (SELECT es.source AS node_id, count(*) AS events_total FROM event_store es WHERE es.source IS NOT NULL AND $__timeFilter(es.created_at) GROUP BY es.source), node_ids AS (SELECT node_id FROM run_stats UNION SELECT node_id FROM source_stats) SELECT n.node_id::text AS id, n.node_id::text AS title, ('runs ' || COALESCE(rs.runs_total, 0)::text || ' events ' || COALESCE(ss.events_total, 0)::text)::text AS subtitle, ('q ' || COALESCE(rs.queue_depth, 0)::text || ' l ' || COALESCE(rs.leased_count, 0)::text || ' r ' || COALESCE(rs.running_count, 0)::text || ' f ' || COALESCE(rs.flushing_count, 0)::text)::text AS mainstat, ('failed ' || COALESCE(rs.failed_count, 0)::text || ' oldest ' || COALESCE(round(rs.oldest_scheduled_age_seconds)::text, '0') || 's')::text AS secondarystat, 'worker' AS node_type, CASE WHEN COALESCE(rs.failed_count, 0) > 0 THEN 'failed' WHEN COALESCE(rs.running_count, 0) > 0 THEN 'running' WHEN COALESCE(rs.flushing_count, 0) > 0 THEN 'flushing' WHEN COALESCE(rs.leased_count, 0) > 0 THEN 'leased' WHEN COALESCE(rs.queue_depth, 0) > 0 THEN 'queued' ELSE 'idle' END AS status, LEAST(72, 38 + sqrt(GREATEST(COALESCE(rs.runs_total, 0), COALESCE(ss.events_total, 0))) * 4)::numeric AS \"nodeRadius\", CASE WHEN COALESCE(rs.failed_count, 0) > 0 THEN 'red' WHEN COALESCE(rs.running_count, 0) > 0 THEN 'green' WHEN COALESCE(rs.flushing_count, 0) > 0 THEN 'blue' WHEN COALESCE(rs.leased_count, 0) > 0 THEN 'yellow' WHEN COALESCE(rs.queue_depth, 0) > 0 THEN 'orange' ELSE 'gray' END AS color FROM node_ids n LEFT JOIN run_stats rs ON rs.node_id = n.node_id LEFT JOIN source_stats ss ON ss.node_id = n.node_id UNION ALL SELECT 'placeholder:no-recent-flow' AS id, 'No recent pipeline flow' AS title, 'selected range' AS subtitle, 'idle' AS mainstat, '' AS secondarystat, 'placeholder' AS node_type, NULL::text AS status, 42::numeric AS \"nodeRadius\", 'gray' AS color WHERE NOT EXISTS (SELECT 1 FROM node_ids) ORDER BY id;"
