{
  "uid": "bugbounty-pipeline-overview",
  "title": "BugBounty Pipeline Overview",
  "schemaVersion": 39,
  "version": 7,
  "refresh": "15s",
  "tags": [
    "bugbounty",
    "pipeline",
    "observability"
  ],
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "node_id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(pipeline_worker_capacity, node_id)",
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "scheduled_status",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(pipeline_scheduled_state_runs, status)",
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "queue",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(rabbitmq_queue_messages_ready, queue)",
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "container",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(container_memory_working_set_bytes{image!=\"\"}, name)",
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Targets Up",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=~\"bugbounty-api|rabbitmq|cadvisor|node-exporter\"}) / clamp_min(count(up{job=~\"bugbounty-api|rabbitmq|cadvisor|node-exporter\"}), 1)"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Host RAM",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - sum(node_memory_MemAvailable_bytes) / sum(node_memory_MemTotal_bytes))"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 3,
        "y": 0
      }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Top Container RAM",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(5, max by (name) (container_memory_working_set_bytes{image!=\"\", name=~\"bb-.*\"}))",
          "legendFormat": "{{name}}"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 6,
        "y": 0
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Worker Use",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(pipeline_worker_busy) / clamp_min(sum(pipeline_worker_capacity), 1)) and on() (max(pipeline_worker_registry_available) == 1)"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 9,
        "y": 0
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Queued Scheduled Runs",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(pipeline_scheduled_state_runs{status=\"queued\", node_id=~\"$node_id\"})"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 12,
        "y": 0
      },
      "description": "Max queued scheduled work across selected nodes."
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Oldest Queued Age",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(pipeline_scheduled_state_oldest_age_seconds{status=\"queued\", node_id=~\"$node_id\"})"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 15,
        "y": 0
      },
      "description": "Oldest active queued scheduled run age in seconds."
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Retry Debt",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(pipeline_retry_due_oldest_age_seconds)"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 18,
        "y": 0
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Reconcile Debt",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(pipeline_reconcile_oldest_age_seconds)"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 21,
        "y": 0
      }
    },
    {
      "id": 100,
      "type": "row",
      "title": "Infrastructure",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "panels": [
        {
          "id": 101,
          "type": "timeseries",
          "title": "Host CPU",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "decimals": 1
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])))"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 0,
            "y": 5
          }
        },
        {
          "id": 103,
          "type": "timeseries",
          "title": "Host IO Wait",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "decimals": 1
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "100 * avg(rate(node_cpu_seconds_total{mode=\"iowait\"}[$__rate_interval]))"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 8,
            "y": 5
          }
        },
        {
          "id": 102,
          "type": "timeseries",
          "title": "Host Memory",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "decimals": 1
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "100 * (1 - sum(node_memory_MemAvailable_bytes) / sum(node_memory_MemTotal_bytes))"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 16,
            "y": 5
          }
        },
        {
          "id": 104,
          "type": "table",
          "title": "Target Status",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "decimals": 0
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "up{job=~\"bugbounty-api|rabbitmq|cadvisor|node-exporter\"}",
              "legendFormat": "{{job}}",
              "instant": true
            }
          ],
          "gridPos": {
            "h": 6,
            "w": 24,
            "x": 0,
            "y": 13
          }
        }
      ]
    },
    {
      "id": 200,
      "type": "row",
      "title": "Containers",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": [
        {
          "id": 201,
          "type": "timeseries",
          "title": "Container CPU Cores",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "cores",
              "decimals": 3
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{image!=\"\", name=~\"$container\"}[$__rate_interval]))",
              "legendFormat": "{{name}}"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 6
          }
        },
        {
          "id": 202,
          "type": "timeseries",
          "title": "Container Memory",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "bytes",
              "decimals": 1
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (name) (container_memory_working_set_bytes{image!=\"\", name=~\"$container\"})",
              "legendFormat": "{{name}}"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 6
          }
        }
      ]
    },
    {
      "id": 300,
      "type": "row",
      "title": "RabbitMQ",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "panels": [
        {
          "id": 301,
          "type": "timeseries",
          "title": "RabbitMQ Ready",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (queue) (rabbitmq_queue_messages_ready)",
              "legendFormat": "{{queue}}"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 6,
            "x": 0,
            "y": 7
          }
        },
        {
          "id": 302,
          "type": "timeseries",
          "title": "RabbitMQ Unacked",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (queue) (rabbitmq_queue_messages_unacked)",
              "legendFormat": "{{queue}}"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 6,
            "x": 6,
            "y": 7
          }
        },
        {
          "id": 303,
          "type": "timeseries",
          "title": "RabbitMQ Consumers",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (queue) (rabbitmq_queue_consumers)",
              "legendFormat": "{{queue}}"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 6,
            "x": 12,
            "y": 7
          }
        },
        {
          "id": 304,
          "type": "timeseries",
          "title": "Queue Backlog Growth",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "deriv(sum by (queue) (rabbitmq_queue_messages_ready)[10m:])",
              "legendFormat": "{{queue}}"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 6,
            "x": 18,
            "y": 7
          }
        },
        {
          "id": 305,
          "type": "timeseries",
          "title": "Queues Without Consumers",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "decimals": 0
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "(sum by (queue) (rabbitmq_queue_messages_ready) > bool 0) * on(queue) (sum by (queue) (rabbitmq_queue_consumers) == bool 0)",
              "legendFormat": "{{queue}}"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 0,
            "y": 15
          }
        },
        {
          "id": 306,
          "type": "timeseries",
          "title": "RabbitMQ Publish Rate",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "ops",
              "decimals": 1
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum(rate(rabbitmq_global_messages_received_total[$__rate_interval]))"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 8,
            "y": 15
          }
        },
        {
          "id": 307,
          "type": "timeseries",
          "title": "RabbitMQ Ack Rate",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "ops",
              "decimals": 1
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum(rate(rabbitmq_global_messages_acknowledged_total[$__rate_interval]))"
            }
          ],
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 16,
            "y": 15
          }
        }
      ]
    },
    {
      "id": 400,
      "type": "row",
      "title": "Workers",
