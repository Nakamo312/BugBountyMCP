+    def _run_raw_with_runtime_limit(
+        self,
+        runner: Any,
+        targets: List[str],
+        context: ToolInvocation | RunnerInvocationContext | None,
+    ):
+        """Run the CLI runner while honoring manifest runtime.concurrency.
+
+        Base Node parallelism controls how many events this node can process.
+        Runtime concurrency controls how many runner processes/streams may be
+        active at once for this specific ScanNode. Keep the semaphore around
+        raw stream consumption so subprocess/network work is bounded without
+        throttling post-run ingestion longer than necessary.
+        """
+
+        async def limited_stream():
+            async with self._scan_semaphore:
+                stream = run_raw(runner, targets, context)
+                async for item in stream:
+                    yield item
+
+        return limited_stream()
+
